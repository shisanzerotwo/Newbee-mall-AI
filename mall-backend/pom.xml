<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <groupId>ltd.newbee.mall</groupId>
    <artifactId>newbee-mall</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>newbee-mall</name>
    <description>newbee-mall是一套电商系统，包括基础版本(Spring Boot+Thymeleaf)、前后端分离版本(Spring Boot+Vue 3+Element-Plus+Vue-Router 4+Vuex 4+Vant 3) 、秒杀版本、Go语言版本、微服务版本(Spring Cloud Alibaba+Nacos+Sentinel+Seata+Spring Cloud Gateway+OpenFeign)。 前台商城系统包含首页门户、商品分类、新品上线、首页轮播、商品推荐、商品搜索、商品展示、购物车、订单结算、订单流程、个人订单管理、会员中心、帮助中心等模块。 后台管理系统包含数据面板、轮播图管理、商品管理、订单管理、会员管理、分类管理、设置等模块。</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <mybatis.start.version>3.0.5</mybatis.start.version>
        <hutool-captcha.version>5.8.47</hutool-captcha.version>
        <!-- LangChain4j：core 与 open-ai 为稳定版（1.20.0）；
             starter / embeddings / community-redis 目前只有 beta（1.20.0-beta30） -->
        <langchain4j.version>1.20.0</langchain4j.version>
        <langchain4j.beta.version>1.20.0-beta30</langchain4j.beta.version>

        <!-- 覆盖 Boot BOM 管理的 Jedis 版本
             【为什么必须覆盖】
             dev.langchain4j:langchain4j-community-redis:1.20.0-beta30 声明 jedis 7.2.1，
             但 spring-boot-dependencies:3.5.16 管理 jedis 6.0.0，父 POM 会强制降级：
               jedis:jar:6.0.0:compile (version managed from 7.2.1)
             运行时可能 NoSuchMethodError（报错点离根因很远）。
             这是 DESIGN §6.4 预检专门要拦的场景（R3）。
             注：Spring Data Redis 默认用 Lettuce，不受此覆盖影响。 -->
        <jedis.version>7.2.1</jedis.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Redis 缓存 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis.start.version}</version>
        </dependency>
        <!-- 验证码 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-captcha</artifactId>
            <version>${hutool-captcha.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ===== AI 客服（M2-1）：LangChain4j 核心 + OpenAI 兼容客户端 ===== -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- ===== M2-3（RAG）=====
             两个 beta 组件：
             - community-redis：RedisEmbeddingStore（用 RediSearch / FT.* 建向量索引，
               需目标 Redis 带 Query Engine，实测本机容器 redis:8 可用）
             - embeddings-all-minilm-l6-v2：内置 ONNX 嵌入模型（首次加载会下载模型文件）
             注：底层用 Jedis，而 Boot BOM 也管理 jedis 版本 —— 引入后必须跑
             `dependency:tree -Dincludes=redis.clients:jedis` 预检（见 DESIGN §6.4 / R3） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-redis</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-all-minilm-l6-v2</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!-- M3 实验：中文嵌入模型（bge-small-zh-v15，512 维）。
             all-MiniLM-L6-v2 是英文模型，实测中文查询 Top3 关键词命中率仅 40%；
             这里引入中文模型做 A/B 对比（见 docs/PERF-M3.md 的 RAG 小节 / RagChineseQualityTest）。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings-bge-small-zh-v15</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>

        <!-- ⚠️ 必须换掉默认的 JDK HttpClient。实测（2026-09-18）：用默认的
             langchain4j-http-client-jdk 调 OmniRoute 网关会报
             java.io.IOException: HTTP/1.1 header parser received no bytes
             （同参数同 key 用 curl 就正常；怀疑是 JDK 客户端的 HTTP/2 升级尝试
               不被 Node 网关支持）。JdkHttpClient.Builder 没有可配项，
             而 OpenAiChatModel.Builder 暴露了 httpClientBuilder(...) → 改用 OkHttp。 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-http-client-okhttp</artifactId>
            <version>${langchain4j.beta.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
