<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ltd.newbee.mall.dao.NewBeeMallGoodsReviewMapper">

    <resultMap id="BaseResultMap" type="ltd.newbee.mall.entity.NewBeeMallGoodsReview">
        <id column="review_id" jdbcType="BIGINT" property="reviewId"/>
        <result column="goods_id" jdbcType="BIGINT" property="goodsId"/>
        <result column="user_id" jdbcType="BIGINT" property="userId"/>
        <result column="review_score" jdbcType="TINYINT" property="reviewScore"/>
        <result column="review_content" jdbcType="VARCHAR" property="reviewContent"/>
        <result column="is_deleted" jdbcType="TINYINT" property="isDeleted"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime"/>
    </resultMap>

    <!-- 展示用:带用户昵称(联查用户表) -->
    <resultMap id="ReviewVOResultMap" type="ltd.newbee.mall.controller.vo.NewBeeMallGoodsReviewVO">
        <id column="review_id" jdbcType="BIGINT" property="reviewId"/>
        <result column="goods_id" jdbcType="BIGINT" property="goodsId"/>
        <result column="user_id" jdbcType="BIGINT" property="userId"/>
        <result column="nick_name" jdbcType="VARCHAR" property="nickName"/>
        <result column="review_score" jdbcType="TINYINT" property="reviewScore"/>
        <result column="review_content" jdbcType="VARCHAR" property="reviewContent"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
    </resultMap>

    <!-- 后台分页查询(支持按商品/用户筛选) -->
    <select id="findGoodsReviewList" parameterType="Map" resultMap="ReviewVOResultMap">
        select r.review_id, r.goods_id, r.user_id, u.nick_name, r.review_score, r.review_content, r.create_time
        from tb_newbee_mall_goods_review r
        left join tb_newbee_mall_user u on r.user_id = u.user_id
        <where>
            r.is_deleted = 0
            <if test="goodsId!=null and goodsId!=''">
                and r.goods_id = #{goodsId}
            </if>
            <if test="userId!=null and userId!=''">
                and r.user_id = #{userId}
            </if>
        </where>
        order by r.review_id desc
        <if test="start!=null and limit!=null">
            limit #{start},#{limit}
        </if>
    </select>

    <!-- 后台评论总数(与列表同条件) -->
    <select id="getTotalGoodsReviews" parameterType="Map" resultType="int">
        select count(*)
        from tb_newbee_mall_goods_review r
        <where>
            r.is_deleted = 0
            <if test="goodsId!=null and goodsId!=''">
                and r.goods_id = #{goodsId}
            </if>
            <if test="userId!=null and userId!=''">
                and r.user_id = #{userId}
            </if>
        </where>
    </select>

    <!-- 前台:某商品的评论列表(按时间倒序) -->
    <select id="selectByGoodsId" parameterType="Long" resultMap="ReviewVOResultMap">
        select r.review_id, r.goods_id, r.user_id, u.nick_name, r.review_score, r.review_content, r.create_time
        from tb_newbee_mall_goods_review r
        left join tb_newbee_mall_user u on r.user_id = u.user_id
        where r.goods_id = #{goodsId} and r.is_deleted = 0
        order by r.review_id desc
    </select>

    <!-- 新增评论 -->
    <insert id="insertSelective" parameterType="ltd.newbee.mall.entity.NewBeeMallGoodsReview"
            useGeneratedKeys="true" keyProperty="reviewId">
        insert into tb_newbee_mall_goods_review
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsId!=null">goods_id,</if>
            <if test="userId!=null">user_id,</if>
            <if test="reviewScore!=null">review_score,</if>
            <if test="reviewContent!=null">review_content,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsId!=null">#{goodsId},</if>
            <if test="userId!=null">#{userId},</if>
            <if test="reviewScore!=null">#{reviewScore},</if>
            <if test="reviewContent!=null">#{reviewContent},</if>
        </trim>
    </insert>

    <!-- 批量逻辑删除 -->
    <update id="deleteBatch">
        update tb_newbee_mall_goods_review
        set is_deleted=1, update_time=now() where review_id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>
</mapper>
