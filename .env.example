# ============================================================
#  newbee-mall-ai 环境变量模板
#  用法：cp .env.example .env  （.env 已在 .gitignore 中，不会入库）
#  docker compose 会自动读取同目录下的 .env
# ============================================================

# ===== 必填 =====
# MySQL root 密码：docker compose 用它初始化容器，应用用它连库
DB_PASSWORD=

# ===== 模型通道（M2-4 起才真正需要）=====
# 留空时应用会打印 WARN 但可正常启动（见 CsAgentConfig.csChatModel）
# 容器内经 host.docker.internal 访问宿主上的 OmniRoute
CS_MODEL_BASE_URL=http://host.docker.internal:20128/v1
CS_MODEL_API_KEY=
CS_MODEL_NAME=auto
